# Auth API
NODE_ENV=development
PORT=3000
AUTH_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=auth
# Local dev only. Use DB_SYNC=false in production (migrations).
DB_SYNC=true
DB_LOGGING=false
# Neon / managed Postgres: DB_SSL=true. Local Postgres: false.
DB_SSL=false

# Redis — e.g. redis://localhost:6379 or your managed provider URL
REDIS_URL=redis://localhost:6379

# JWT — use long random strings in production
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=24h

# Frontend URL used to build reset-password links
APP_FRONTEND_URL=http://localhost:3000

# Seeder: required for super admin credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me-super-admin
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PHONE=+201000000001
SUPER_ADMIN_COUNTRY_CODE=EG

# Optional: publish ports when they conflict (local tooling)
# POSTGRES_PUBLISH_PORT=5432
# REDIS_PUBLISH_PORT=6379
